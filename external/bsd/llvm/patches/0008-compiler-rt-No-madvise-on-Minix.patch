compiler-rt profile runtime: MINIX has no madvise(); skip releasing pages like on VE and WASI.

diff --git a/compiler-rt/lib/profile/InstrProfilingUtil.c b/compiler-rt/lib/profile/InstrProfilingUtil.c
index a9d9df8137..602b062e1e 100644
--- a/compiler-rt/lib/profile/InstrProfilingUtil.c
+++ b/compiler-rt/lib/profile/InstrProfilingUtil.c
@@ -488,8 +488,8 @@ COMPILER_RT_VISIBILITY void lprofRestoreSigKill(void) {
 
 COMPILER_RT_VISIBILITY int lprofReleaseMemoryPagesToOS(uintptr_t Begin,
                                                        uintptr_t End) {
-#if defined(__ve__) || defined(__wasi__)
-  // VE and WASI doesn't support madvise.
+#if defined(__ve__) || defined(__wasi__) || defined(__minix)
+  // VE, WASI and MINIX don't support madvise.
   return 0;
 #else
   size_t PageSize = getpagesize();
