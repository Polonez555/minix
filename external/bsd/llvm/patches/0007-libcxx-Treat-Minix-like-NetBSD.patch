libc++: treat MINIX like NetBSD (ctype masks, xlocale *_l functions, arc4random, endian), as
the MINIX libc++ 3.6 patches did. MINIX libc is NetBSD's and provides all of these.

diff --git a/libcxx/include/__config b/libcxx/include/__config
index d765673191..e0c7340e95 100644
--- a/libcxx/include/__config
+++ b/libcxx/include/__config
@@ -93,7 +93,7 @@
 //      Use rand_s(), for use on Windows.
 //      When this option is used, the token passed to `std::random_device`'s
 //      constructor *must* be "/dev/urandom" -- anything else is an error.
-#  if defined(__APPLE__) || defined(__FreeBSD__) || defined(__NetBSD__) || defined(__OpenBSD__) ||                     \
+#  if defined(__APPLE__) || defined(__FreeBSD__) || (defined(__NetBSD__) || defined(__minix)) || defined(__OpenBSD__) ||                     \
       defined(__DragonFly__)
 #    define _LIBCPP_USING_ARC4_RANDOM
 #  elif defined(__wasi__) || defined(__EMSCRIPTEN__)
@@ -211,7 +211,7 @@ typedef __char32_t char32_t;
 
 #    if defined(__FreeBSD__) ||                                                                                        \
         defined(__wasi__) ||                                                                                           \
-        defined(__NetBSD__) ||                                                                                         \
+        (defined(__NetBSD__) || defined(__minix)) ||                                                                                         \
         defined(__OpenBSD__) ||                                                                                        \
         defined(__NuttX__) ||                                                                                          \
         defined(__linux__) ||                                                                                          \
