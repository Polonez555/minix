Use DWARF CFI exception tables for Minix on ARM, like NetBSD (chosen over ARM EHABI).

diff --git a/llvm/lib/Target/ARM/MCTargetDesc/ARMMCAsmInfo.cpp b/llvm/lib/Target/ARM/MCTargetDesc/ARMMCAsmInfo.cpp
index d6abb2485a..641ecd21a3 100644
--- a/llvm/lib/Target/ARM/MCTargetDesc/ARMMCAsmInfo.cpp
+++ b/llvm/lib/Target/ARM/MCTargetDesc/ARMMCAsmInfo.cpp
@@ -93,6 +93,7 @@ ARMELFMCAsmInfo::ARMELFMCAsmInfo(const Triple &TheTriple,
   // Exceptions handling
   switch (TheTriple.getOS()) {
   case Triple::NetBSD:
+  case Triple::Minix:
     ExceptionsType = ExceptionHandling::DwarfCFI;
     break;
   default:
